    <type name="InnoShip\InnoShip\Model\Checkout\SelectedLockerConfigProvider">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </type>
</config>
