<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Shipping\Block\Adminhtml\View">
        <plugin name="innoship_innoship_adminhtml_shipping_view_add_button" type="InnoShip\InnoShip\Plugin\Shipping\Block\Adminhtml\View" sortOrder="10"/>
    </type>
    <type name="Magento\Sales\Block\Adminhtml\Order\View">
        <plugin name="innoship_innoship_adminhtml_order_view_add_button" type="InnoShip\InnoShip\Plugin\Order\Block\Adminhtml\View" sortOrder="10"/>
    </type>
    <!-- MSI services built only when used (Create checks Magento_InventorySalesApi first), so the AWB
         controller instantiates on a store with the Inventory modules disabled. -->
    <type name="InnoShip\InnoShip\Controller\Adminhtml\Awb\Create">
        <arguments>
            <argument name="stockByWebsiteIdResolver" xsi:type="object">Magento\InventorySalesApi\Model\StockByWebsiteIdResolverInterface\Proxy</argument>
            <argument name="getSourcesAssignedToStockOrderedByPriority" xsi:type="object">Magento\InventoryApi\Api\GetSourcesAssignedToStockOrderedByPriorityInterface\Proxy</argument>
            <argument name="defaultSourceProvider" xsi:type="object">Magento\InventoryCatalogApi\Api\DefaultSourceProviderInterface\Proxy</argument>
        </arguments>
    </type>
</config>
